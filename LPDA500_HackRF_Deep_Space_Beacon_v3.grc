    entry_signal: editingFinished
    gui_hint: ''
    label: RF Carrier Frequency (Hz)
    type: real
    value: 850e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [736, 4.0]
    rotation: 0
    state: enabled
- name: ctcss_freq
