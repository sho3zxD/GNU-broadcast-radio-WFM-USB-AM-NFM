options:
  parameters:
    author: Radio Operator
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: Multimode HackRF transmitter with real GUI sliders for beacon preamble
      length and repeat interval
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: lpda500_hackrf_tx_test
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: LPDA-500 HackRF Multimode TX + Deep Space Beacon Controls
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [32, 0.0]
    rotation: 0
    state: enabled

blocks:
- name: audio_input_select
  id: variable_qtgui_chooser
  parameters:
    comment: ''
    gui_hint: ''
    label: Audio Source
    label0: Edge + Media Player
    label1: Default Windows Input
    label2: ''
    label3: ''
    label4: ''
    labels: '[]'
    num_opts: '2'
    option0: '0'
    option1: '1'
    option2: '2'
    option3: '3'
    option4: '4'
    options: '[''0'', ''1'']'
    orient: Qt.QVBoxLayout
    type: int
    value: '0'
    widget: combo_box
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1304, 4.0]
    rotation: 0
    state: enabled
- name: beacon_preamble_len
  id: variable_qtgui_range
  parameters:
    comment: Length of the known beacon synchronization preamble in symbols.
    gui_hint: ''
    label: Beacon Preamble Length (symbols)
    min_len: '260'
    orient: QtCore.Qt.Horizontal
    rangeType: int
    start: '16'
    step: '16'
    stop: '4096'
    value: '256'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1304, 104.0]
    rotation: 0
    state: enabled
- name: beacon_repeat_interval
  id: variable_qtgui_range
  parameters:
    comment: Time between complete beacon repetitions in seconds.
    gui_hint: ''
    label: Beacon Repeat Interval (seconds)
    min_len: '260'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0.5'
    step: '0.5'
    stop: '60.0'
    value: '5.0'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1304, 164.0]
    rotation: 0
    state: enabled
- name: carrier_freq
  id: variable_qtgui_entry
